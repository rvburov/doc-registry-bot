# Образец настроек. Скопируйте в .env рядом с compose.yaml и заполните.
# .env в Git не хранится: в нем пароли. Права на файл: chmod 600 .env

# Версия бота. Ее выставляет update.sh при установке новой версии.
BOT_VERSION=1.2.0

# Служба мессенджера: имя ее контейнера в общей сети Docker и порт.
MESSENGER_URL=http://messenger-api:8888
# Общая сеть Docker со службой мессенджера (docker network create messenger).
MESSENGER_NETWORK=messenger

# Владельцы: числовые userId из карточек мессенджера, через запятую.
# Свой userId: ./contacts.sh | grep Фамилия (число слева).
OWNER_IDS=123456

# Коды организации: 4 заглавные русские буквы, через запятую. Это первые буквы обозначений в
# журнале: АБВГ.301121.001 -> АБВГ.
ORG_CODES=АБВГ

# База бота: PostgreSQL в этом же compose, снаружи недоступна. Ставить PostgreSQL отдельно не нужно:
# при первом запуске Docker сам создает базу с этим именем, пользователем и паролем.
# Заполнить до первого запуска: PostgreSQL читает эти строки один раз, когда создает базу.
# Имя и пользователя можно оставить. Пароль: openssl rand -hex 24 и скопировать строку.
# В пароле нельзя $ и пробелы. Вводить его потом не нужно, но .env не теряйте.
POSTGRES_DB=doc_registry
POSTGRES_USER=doc_registry
POSTGRES_PASSWORD=замените-на-длинный-пароль

# Папки для резервных копий из чата (команда «Резервная копия»), до трех. Номер в чате — номер
# здесь, папка 1 — по умолчанию. Путь — как его понимает Docker: в WSL диск E: это /mnt/e
# (E:\Копии -> /mnt/e/Копии), на сервере обычная папка (/srv/копии). Путь начинается с / или ./
# Пишет в эти папки только контейнер копий; других папок компьютера бот не видит.
# После изменения: docker compose up -d (простой restart новые папки не подключит).
BACKUP_DIR_1=./backups
BACKUP_DIR_1_NAME=Основная
BACKUP_DIR_2=
BACKUP_DIR_2_NAME=Архив
BACKUP_DIR_3=
BACKUP_DIR_3_NAME=Папка 3

# Еженедельное напоминание владельцу сделать резервную копию (ночной копии по расписанию нет).
# День: пн, вт, ср, чт, пт, сб, вс или нет (выключить). Время ЧЧ:ММ. Пояс: пусто = Europe/Moscow.
BACKUP_REMINDER_DAY=пн
BACKUP_REMINDER_TIME=10:00
BACKUP_REMINDER_ZONE=

# Сетевая папка для копий (Windows): //сервер/папка, пользователь и пароль с правом записи.
# В чате она предлагается последней. Защитная копия перед обновлением тоже уходит туда.
# Нет папки (и на ПК): оставьте все четыре строки пустыми, например BACKUP_SHARE=
BACKUP_SHARE=//fileserver/backups/doc-registry
BACKUP_SHARE_NAME=Сетевая папка
BACKUP_SHARE_USER=svc-backup
BACKUP_SHARE_PASSWORD=замените
BACKUP_SHARE_DOMAIN=
